# Copie este archivo como .env y cambie los valores (el .env NO se sube a GitHub)

# --- MongoDB (administrador del contenedor, solo para inicializar) ---
MONGO_ROOT_USER=root_gastro
MONGO_ROOT_PASSWORD=cambie_esta_clave_root

# --- Base de datos y usuarios de privilegios mínimos ---
MONGO_DB=bd_gastronomia
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_APP_USER=c_api_gastronomia
MONGO_APP_PASSWORD=cambie_esta_clave_api
MONGO_REPORT_USER=c_reportes_gastronomia
MONGO_REPORT_PASSWORD=cambie_esta_clave_reportes

# --- JWT ---
JWT_SECRET=genere_una_clave_larga_y_aleatoria
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- General ---
ZONA_HORARIA=America/Bogota
